{
  "name": "dsh-desktop",
  "version": "1.2.0",
  "description": "DeepSeek Harness 桌面客户端 - 类 ChatGPT 体验",
  "main": "main.js",
  "author": {
    "name": "SmileSilence",
    "email": "1916360717@qq.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/SmileSilence/dsh-desktop#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/SmileSilence/dsh-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/SmileSilence/dsh-desktop/issues"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"tests/*.spec.mjs\"",
    "icons": "electron scripts/make-icons.mjs && node scripts/pack-ico.mjs",
    "build": "powershell -ExecutionPolicy Bypass -File scripts/build-preview.ps1",
    "build:win": "electron-builder --win",
    "pack": "electron-builder --dir",
    "pack:win": "electron-packager . \"DeepSeek Harness\" --platform=win32 --arch=x64 --out=dist --overwrite",
    "pack:win:dir": "electron-packager . \"DeepSeek Harness\" --platform=win32 --arch=x64 --out=dist --overwrite --asar"
  },
  "keywords": [
    "deepseek",
    "harness",
    "ai",
    "desktop",
    "chatgpt"
  ],
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.dsh.desktop",
    "productName": "DeepSeek Harness",
    "copyright": "Copyright © 2026 DSH Community",
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": ["nsis"],
      "icon": "assets/app.ico",
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness"
    },
    "files": [
      "main.js",
      "main/**/*",
      "preload.js",
      "assets/icon.png",
      "assets/icon-256.png"
    ]
  },
  "allowScripts": {
    "electron@35.7.5": true
  }
}
